# One-off admin/management image (e.g. `pnpm import-projects`, `pnpm seed`).
# Unlike Dockerfile.prod, this keeps full node_modules + source so scripts
# under src/scripts and data under projects/*.json are actually present.
# Not meant to serve traffic — run with an explicit command via `docker run`.
FROM node:20-alpine AS tools
WORKDIR /app

RUN apk add --no-cache libc6-compat
RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

CMD ["pnpm", "run", "import-projects"]
