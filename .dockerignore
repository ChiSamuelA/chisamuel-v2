# Ignore git directory
.git

# Ignore local dependency folders
node_modules

# Exclude Next.js completely but allow only the standalone build artifacts
.next
!.next/standalone
!.next/static
!.next/server
!.next/BUILD_ID
!.next/*.json

# Ignore test results and reports
test-results
playwright-report
playwright/.cache

# Ignore dev design folder and staging artifacts
claude-design
build-art
